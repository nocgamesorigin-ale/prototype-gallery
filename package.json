{
  "name": "prototype-gallery",
  "private": true,
  "version": "1.0.0",
  "description": "Thư viện prototype game HTML5, chạy trên GitHub Pages, khoá bằng mật khẩu chung.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "submit": "node scripts/submit.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --open && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
